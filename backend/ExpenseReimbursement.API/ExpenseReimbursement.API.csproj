<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API = the HTTP layer. Controllers receive requests, read the logged-in user
    from the JWT, call one service method and turn the result into a status code.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>expenso-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.*" />
    <!-- Needed only at design time for "dotnet ef migrations add". -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseReimbursement.Core\ExpenseReimbursement.Core.csproj" />
    <ProjectReference Include="..\ExpenseReimbursement.Infrastructure\ExpenseReimbursement.Infrastructure.csproj" />
  </ItemGroup>

</Project>
