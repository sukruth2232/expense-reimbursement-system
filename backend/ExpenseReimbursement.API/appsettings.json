{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Expenso.API",
    "Audience": "Expenso.Web",
    "ExpiryMinutes": 60,
    "SigningKey": ""
  },
  "FileStorage": {
    "RootPath": "storage/receipts",
    "MaxFileSizeBytes": 5242880
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Seed": {
    "DefaultPassword": ""
  }
}
