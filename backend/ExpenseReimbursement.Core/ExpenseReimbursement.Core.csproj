<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core = the "heart" of the application.
    It holds entities, enums, DTOs, interfaces and business rules.
    It has NO dependency on EF Core, ASP.NET Core or PostgreSQL, so the rules
    can be read and tested without any infrastructure.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
