<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure = everything that talks to the outside world:
    PostgreSQL (EF Core + Npgsql), the file system (receipts) and JWT signing.
    It implements the interfaces declared in Core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to IOptions, configuration binding and PasswordHasher<T>. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- "10.*" = latest 10.x patch; never jumps to 11. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseReimbursement.Core\ExpenseReimbursement.Core.csproj" />
  </ItemGroup>

</Project>
